# Multi-Search Aggregator Configuration
# Copy this file and override values as needed.
# API keys are read from environment variables (see .env.example).

# --- Paths ---
workspace: "./workspace"

# --- Engine defaults ---
timeout: 35          # per-engine timeout in seconds
max_workers: 40      # ThreadPoolExecutor max workers
retry_delay: 0.5     # seconds between retry attempts

# --- Output ---
output_dir: "./output/search_results"

# === 服务器配置 ===
server:
  host: "0.0.0.0"
  port: 8200
  cors_origins:
    - "*"

# === 搜索默认值 ===
search:
  default_top_k: 50
  max_top_k: 200
  default_timeout: 35
  max_workers: 40

# --- Engine weights (higher = more authoritative) ---
# Modify to adjust engine influence on scoring.
weights:
  # API/MCP 直连
  智谱Pro: 9
  智谱Sogou: 8
  智谱Quark: 7
  Z.AI: 9
  百炼: 9

  # opencli lightweight
  Hacker News: 7
  Stack Overflow: 8
  Wikipedia: 5
  arXiv: 8
  OpenAlex: 6
  OpenReview: 6
  DBLP: 6
  npm: 5
  crates.io: 5
  MDN: 6

  # opencli heavy
  Substack: 5
  微信读书: 5
  Google: 10
  知乎: 8
  Reddit: 7
  小红书: 5

  # web_fetch
  Bing国内: 7
  Bing国际: 8
  360搜索: 6
  搜狗Web: 6
  微信搜一搜: 6
  Startpage: 6
  Brave_WF: 6
  Qwant: 5

  # MCP stdio
  EnhancedBing: 8

  # Skill
  AMiner论文: 7
  AMiner专利: 7
  知乎Skill: 7

# --- Individual engine overrides ---
# Set `enabled: false` to disable an engine, or override timeout/weight.
engine_overrides:
  # Example:
  # zhipu_pro:
  #   enabled: false
  #   timeout: 20
