{
  "title": "Kindly MCP - Provider Health & Latency",
  "uid": "kindly-mcp-providers-v2",
  "version": 1,
  "tags": ["kindly", "mcp", "providers", "otel", "health"],
  "schemaVersion": 41,
  "refresh": "1m",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      },
      {
        "name": "provider",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(provider_name)",
        "label": "Provider",
        "includeAll": true,
        "allValue": ".+"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Provider Request Rate",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(rate(provider_calls_total{provider_name=~\"$provider\"}[5m])) by (provider_name)", "refId": "A", "legendFormat": "{{provider_name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Provider p95 Latency",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(provider_duration_seconds_bucket{provider_name=~\"$provider\"}[5m])) by (le, provider_name))", "refId": "A", "legendFormat": "{{provider_name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Provider Success Rate",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(rate(provider_calls_total{provider_name=~\"$provider\", status=\"success\"}[5m])) by (provider_name) / sum(rate(provider_calls_total{provider_name=~\"$provider\"}[5m])) by (provider_name) * 100", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["mean"] }, "orientation": "horizontal" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ {"color": "red", "value": null}, {"color": "yellow", "value": 90}, {"color": "green", "value": 99} ] } } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Provider Error Rate",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(rate(provider_calls_total{provider_name=~\"$provider\", status=\"error\"}[5m])) by (provider_name) / sum(rate(provider_calls_total{provider_name=~\"$provider\"}[5m])) by (provider_name) * 100", "refId": "A", "legendFormat": "{{provider_name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Provider Freshness (seconds since last success)",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "time() - max by (provider_name) (provider_last_success_timestamp{provider_name=~\"$provider\"})", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ {"color": "green", "value": null}, {"color": "yellow", "value": 600}, {"color": "red", "value": 1800} ] } } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Circuit Breaker State Changes",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(rate(circuit_breaker_transitions_total{provider_name=~\"$provider\"}[5m])) by (provider_name, transition)", "refId": "A", "legendFormat": "{{provider_name}} {{transition}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Results Returned per Provider",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(rate(provider_results_total{provider_name=~\"$provider\"}[5m])) by (provider_name)", "refId": "A", "legendFormat": "{{provider_name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Provider Health Summary",
      "gridPos": { "x": 0, "y": 29, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { 
          "expr": "provider_health_status{provider_name=~\"$provider\"}", 
          "refId": "A", 
          "format": "table", 
          "instant": true
        }
      ],
      "transform": "table"
    }
  ]
}