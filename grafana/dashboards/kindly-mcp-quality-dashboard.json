{
  "title": "Kindly MCP - Quality Assessment",
  "uid": "kindly-mcp-quality-v2",
  "version": 1,
  "tags": ["kindly", "mcp", "quality", "search", "rerank", "judge", "ndcg", "otel"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Avg NDCG@10",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "avg(search_ndcg_at_10)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 3, "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ {"color": "red", "value": null}, {"color": "yellow", "value": 0.6}, {"color": "green", "value": 0.8} ] } } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Avg Judge Score",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "avg(judge_evaluation_overall_score)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2, "min": 0, "max": 5, "thresholds": { "mode": "absolute", "steps": [ {"color": "red", "value": null}, {"color": "yellow", "value": 3}, {"color": "green", "value": 4} ] } } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Domain Diversity",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "avg(search_domain_diversity_ratio)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ {"color": "red", "value": null}, {"color": "yellow", "value": 0.3}, {"color": "green", "value": 0.5} ] } } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Provider Overlap Rate",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "avg(search_provider_overlap_rate)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ {"color": "yellow", "value": null}, {"color": "green", "value": 0.3} ] } } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Rerank Compression",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "avg(search_rerank_compression_ratio)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2, "min": 0, "thresholds": { "mode": "absolute", "steps": [ {"color": "green", "value": null} ] } } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Judge Evaluations",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "count(judge_evaluation_overall_score)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "NDCG@10 Over Time",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "avg_over_time(search_ndcg_at_10[5m])", "refId": "A", "legendFormat": "NDCG@10" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1 } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Judge Score Distribution",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "avg_over_time(judge_evaluation_relevance_score[5m])", "refId": "A", "legendFormat": "Relevance" },
        { "expr": "avg_over_time(judge_evaluation_accuracy_score[5m])", "refId": "B", "legendFormat": "Accuracy" },
        { "expr": "avg_over_time(judge_evaluation_completeness_score[5m])", "refId": "C", "legendFormat": "Completeness" },
        { "expr": "avg_over_time(judge_evaluation_source_quality_score[5m])", "refId": "D", "legendFormat": "Source Quality" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 5 } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "RRF Score Distribution",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(search_rrf_score_bucket[5m])) by (le))", "refId": "A", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(search_rrf_score_bucket[5m])) by (le))", "refId": "B", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Domain Diversity Trend",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "avg_over_time(search_domain_diversity_count[5m])", "refId": "A", "legendFormat": "Domains" },
        { "expr": "avg_over_time(search_domain_diversity_ratio[5m]) * 10", "refId": "B", "legendFormat": "Ratio (×10)" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 11,
      "type": "histogram",
      "title": "Judge Score Histogram",
      "gridPos": { "x": 0, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(rate(judge_evaluation_overall_score_bucket[5m])) by (le)", "refId": "A" }
      ]
    },
    {
      "id": 12,
      "type": "gauge",
      "title": "Quality Grade",
      "gridPos": { "x": 8, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "avg(judge_evaluation_overall_score) / 5 * 100", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ {"color": "red", "value": null}, {"color": "yellow", "value": 60}, {"color": "green", "value": 80} ] } } }
    },
    {
      "id": 13,
      "type": "piechart",
      "title": "Quality Tier Distribution",
      "gridPos": { "x": 16, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "count(judge_evaluation_overall_score < 2)", "refId": "A", "legendFormat": "Poor" },
        { "expr": "count(judge_evaluation_overall_score >= 2 and judge_evaluation_overall_score < 3)", "refId": "B", "legendFormat": "Fair" },
        { "expr": "count(judge_evaluation_overall_score >= 3 and judge_evaluation_overall_score < 4)", "refId": "C", "legendFormat": "Good" },
        { "expr": "count(judge_evaluation_overall_score >= 4)", "refId": "D", "legendFormat": "Excellent" }
      ]
    },
    {
      "id": 14,
      "type": "table",
      "title": "Judge Evaluation Details",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "judge_evaluation_overall_score", "refId": "A", "format": "table", "instant": true }
      ],
      "transform": "table"
    }
  ]
}