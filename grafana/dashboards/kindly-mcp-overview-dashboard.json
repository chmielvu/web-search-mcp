{
  "title": "Kindly MCP - Overview (Golden Signals)",
  "uid": "kindly-mcp-overview-v2",
  "version": 1,
  "tags": ["kindly", "mcp", "web-search", "otel", "grafana-cloud", "golden-signals"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      },
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(service_name)",
        "label": "Service",
        "current": { "text": "web-search-mcp", "value": "web-search-mcp" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Request Rate (5m)",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(rate(mcp_tool_calls_total{service=\"${service}\"}[5m]))", "refId": "A", "legendFormat": "req/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "thresholds": { "mode": "absolute", "steps": [ {"color": "green", "value": null} ] } } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error Rate (5m)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(rate(mcp_tool_calls_total{service=\"${service}\", status=\"error\"}[5m])) / sum(rate(mcp_tool_calls_total{service=\"${service}\"}[5m])) * 100", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ {"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5} ] } } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 Latency",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(mcp_tool_duration_seconds_bucket{service=\"${service}\"}[5m])) by (le))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ {"color": "green", "value": null}, {"color": "yellow", "value": 2}, {"color": "red", "value": 5} ] } } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "LLM Cost Rate",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(rate(llm_usage_cost_usd_total{service=\"${service}\"}[5m])) * 3600", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "thresholds": { "mode": "absolute", "steps": [ {"color": "green", "value": null} ] } } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active Providers",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "count(count by (provider_name) (rate(provider_calls_total{service=\"${service}\"}[5m]) > 0))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [ {"color": "green", "value": null} ] } } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Cache Hit Rate",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(rate(cache_hits_total{service=\"${service}\"}[5m])) / (sum(rate(cache_hits_total{service=\"${service}\"}[5m])) + sum(rate(cache_misses_total{service=\"${service}\"}[5m]))) * 100", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ {"color": "red", "value": null}, {"color": "yellow", "value": 50}, {"color": "green", "value": 80} ] } } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request & Error Rate",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(rate(mcp_tool_calls_total{service=\"${service}\"}[5m]))", "refId": "A", "legendFormat": "Requests" },
        { "expr": "sum(rate(mcp_tool_calls_total{service=\"${service}\", status=\"error\"}[5m]))", "refId": "B", "legendFormat": "Errors" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency Percentiles",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(mcp_tool_duration_seconds_bucket{service=\"${service}\"}[5m])) by (le))", "refId": "A", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(mcp_tool_duration_seconds_bucket{service=\"${service}\"}[5m])) by (le))", "refId": "B", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(mcp_tool_duration_seconds_bucket{service=\"${service}\"}[5m])) by (le))", "refId": "C", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Token Usage by Purpose",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(rate(llm_usage_input_tokens_total{service=\"${service}\"}[5m])) by (call_purpose)", "refId": "A", "legendFormat": "{{call_purpose}} input" },
        { "expr": "sum(rate(llm_usage_output_tokens_total{service=\"${service}\"}[5m])) by (call_purpose)", "refId": "B", "legendFormat": "{{call_purpose}} output" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Cost by Provider",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(rate(llm_usage_cost_usd_total{service=\"${service}\"}[5m])) by (provider) * 3600", "refId": "A", "legendFormat": "{{provider}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Provider Health Status",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "provider_health_status{service=\"${service}\"}", "refId": "A", "format": "table", "instant": true }
      ],
      "transform": "table",
      "fieldConfig": { "overrides": [ { "matcher": { "id": "byName", "options": "status" }, "properties": [ { "id": "mappings", "value": [ { "type": "value", "options": { "healthy": { "color": "green", "text": "✓ Healthy" }, "degraded": { "color": "yellow", "text": "⚠ Degraded" }, "down": { "color": "red", "text": "✗ Down" } } } ] } ] } ] }
    }
  ]
}